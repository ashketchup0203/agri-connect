# Copy this file, rename the copy to .env, and fill in the values
# from your Clever Cloud MySQL add-on dashboard.
# Never upload .env to GitHub.
MYSQL_ADDON_HOST=
MYSQL_ADDON_PORT=3306
MYSQL_ADDON_USER=
MYSQL_ADDON_PASSWORD=
MYSQL_ADDON_DB=

# Keeps users signed in (any long random text)
SESSION_SECRET=
